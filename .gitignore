# --------------------------------------------------- Analysed email data --
# Mailbox CSVs accumulate the content of every email analysed locally, which
# is user data rather than source. The directories are kept via .gitkeep so a
# fresh clone still has somewhere to write.
data/inbox/*.csv
data/quarantine/*.csv
!data/**/.gitkeep

# Large DERIVED datasets only - each is reproducible from a script, and they
# total well over 300 MB. Source datasets (data/raw/email_spam.csv) stay
# tracked because they cannot be regenerated.
#
# Rebuild with:
#   python -m src.data.build_phishing_dataset   -> phishing_combined.csv
#   python -m src.data.preprocess_phishing      -> phishing_cleaned.csv
#   python -m src.models.train_phishing_bert --split-only  -> train/val/test
data/raw/phishing_combined.csv
data/processed/phishing_cleaned.csv
data/processed/train.csv
data/processed/validation.csv
data/processed/test.csv

